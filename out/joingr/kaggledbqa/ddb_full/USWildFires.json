{"nodes": {"5e9c3534283255a9": {"node_id": "5e9c3534283255a9", "node_name": "USWildFires.Fires.CONT_DATE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "CONT_DATE", "semantic_column_name": "containment_date", "column_purpose": "Date the fire was contained, stored as a Julian date (days since Jan 1, 4713 BC; .5 = midnight/noon convention). Empty for ~47% of rows (fires with no recorded containment). Range 2448622.5-2457391.5 corresponds to ~1992-2015.", "column_type": "VARCHAR", "is_key": false}, "a9c8752e0358e904": {"node_id": "a9c8752e0358e904", "node_name": "USWildFires.Fires.CONT_DOY", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "CONT_DOY", "semantic_column_name": "containment_day_of_year", "column_purpose": "Day of year (1-366) on which the fire was contained; empty when containment date is missing.", "column_type": "VARCHAR", "is_key": false}, "8d75094c32455f74": {"node_id": "8d75094c32455f74", "node_name": "USWildFires.Fires.CONT_TIME", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "CONT_TIME", "semantic_column_name": "containment_time", "column_purpose": "Time of containment in 24-hour HHMM format (e.g. 0701, 1800). Empty for ~52% of rows.", "column_type": "VARCHAR", "is_key": false}, "277cb8e614fd568d": {"node_id": "277cb8e614fd568d", "node_name": "USWildFires.Fires.COUNTY", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "COUNTY", "semantic_column_name": "county_fips_code", "column_purpose": "County FIPS code (3-digit, zero-padded) of the fire location; empty for ~36% of rows. Some rows appear to hold non-numeric values (e.g. '5', 'Lincoln', 'SUFFOLK'), suggesting mixed/uncleaned county identifiers.", "column_type": "VARCHAR", "is_key": false}, "2f73e0087797399a": {"node_id": "2f73e0087797399a", "node_name": "USWildFires.Fires.DISCOVERY_DATE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "DISCOVERY_DATE", "semantic_column_name": "discovery_date", "column_purpose": "Date the fire was discovered, as a Julian date (same convention as CONT_DATE). Always populated; range 2448622.5-2457387.5 (~1992-2015).", "column_type": "DOUBLE", "is_key": false}, "8c939ec32e119a34": {"node_id": "8c939ec32e119a34", "node_name": "USWildFires.Fires.DISCOVERY_DOY", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "DISCOVERY_DOY", "semantic_column_name": "discovery_day_of_year", "column_purpose": "Day of year (1-366) on which the fire was discovered. Peak around DOY 185 (early July).", "column_type": "BIGINT", "is_key": false}, "163a2b3c283f6d6f": {"node_id": "163a2b3c283f6d6f", "node_name": "USWildFires.Fires.DISCOVERY_TIME", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "DISCOVERY_TIME", "semantic_column_name": "discovery_time", "column_purpose": "Time of discovery in 24-hour HHMM format (e.g. 1400, 0235). Empty for ~47% of rows.", "column_type": "VARCHAR", "is_key": false}, "8303469f44d8ae0f": {"node_id": "8303469f44d8ae0f", "node_name": "USWildFires.Fires.FIPS_CODE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "FIPS_CODE", "semantic_column_name": "county_fips_code", "column_purpose": "3-digit county FIPS code within the state; empty for ~36% of rows. Pairs with STATE to form the full 5-digit county FIPS.", "column_type": "VARCHAR", "is_key": false}, "0a53ece3a64b8505": {"node_id": "0a53ece3a64b8505", "node_name": "USWildFires.Fires.FIPS_NAME", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "FIPS_NAME", "semantic_column_name": "county_name", "column_purpose": "Name of the county (FIPS_NAME) matching FIPS_CODE; empty for ~36% of rows.", "column_type": "VARCHAR", "is_key": false}, "6cf9d773fefbcd00": {"node_id": "6cf9d773fefbcd00", "node_name": "USWildFires.Fires.FIRE_SIZE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "FIRE_SIZE", "semantic_column_name": "fire_size_acres", "column_purpose": "Final size of the fire in acres (median 1.0, max 606,945 acres). Matches the standard US wildfire size convention.", "column_type": "DOUBLE", "is_key": false}, "edc3c041be52733d": {"node_id": "edc3c041be52733d", "node_name": "USWildFires.Fires.FIRE_SIZE_CLASS", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "FIRE_SIZE_CLASS", "semantic_column_name": "fire_size_class", "column_purpose": "Size class code A-G based on acreage: A = <=0.25 ac, B = 0.26-9.9, C = 10-99, D = 100-299, E = 300-999, F = 1000-4999, G = >=5000 acres. Distribution (B most common) is consistent with this standard NWCG scheme.", "column_type": "VARCHAR", "is_key": false}, "df8cf9c9eb89f93b": {"node_id": "df8cf9c9eb89f93b", "node_name": "USWildFires.Fires.FIRE_YEAR", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "FIRE_YEAR", "semantic_column_name": "fire_year", "column_purpose": "Calendar year of the fire, 1992-2015.", "column_type": "BIGINT", "is_key": false}, "64880982942eb52c": {"node_id": "64880982942eb52c", "node_name": "USWildFires.Fires.LATITUDE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "LATITUDE", "semantic_column_name": "latitude", "column_purpose": "Latitude of the fire ignition point in decimal degrees (range 17.94-70.33, covering US states/territories including Alaska and Hawaii).", "column_type": "DOUBLE", "is_key": false}, "9d0b0d477bc36ba9": {"node_id": "9d0b0d477bc36ba9", "node_name": "USWildFires.Fires.LONGITUDE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "LONGITUDE", "semantic_column_name": "longitude", "column_purpose": "Longitude of the fire ignition point in decimal degrees (negative, range -178.8 to -65.3).", "column_type": "DOUBLE", "is_key": false}, "0158a20995f91667": {"node_id": "0158a20995f91667", "node_name": "USWildFires.Fires.OWNER_CODE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "OWNER_CODE", "semantic_column_name": "owner_code", "column_purpose": "Numeric code for the land ownership/owner of the fire location; pairs with OWNER_DESCR (e.g. 14 = MISSING/NOT SPECIFIED, 8 = PRIVATE, 5 = USFS, 2 = BIA, 13 = STATE OR PRIVATE).", "column_type": "DOUBLE", "is_key": false}, "f30a05c59661ef1e": {"node_id": "f30a05c59661ef1e", "node_name": "USWildFires.Fires.OWNER_DESCR", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "OWNER_DESCR", "semantic_column_name": "owner_description", "column_purpose": "Text description of land ownership at the fire location (USFS, BIA, BLM, PRIVATE, COUNTY, etc.).", "column_type": "VARCHAR", "is_key": false}, "252c6bbd44d5ba21": {"node_id": "252c6bbd44d5ba21", "node_name": "USWildFires.Fires.STATE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "STATE", "semantic_column_name": "state_code", "column_purpose": "Two-letter USPS state/territory abbreviation where the fire occurred (52 values: 50 states + DC + PR).", "column_type": "VARCHAR", "is_key": false}, "6061fbc4e659508c": {"node_id": "6061fbc4e659508c", "node_name": "USWildFires.Fires.STAT_CAUSE_CODE", "db_id": "USWildFires", "table_name": "USWildFires.Fires", "semantic_table_name": "Fires", "column_name": "STAT_CAUSE_CODE", "semantic_column_name": "cause_code", "column_purpose": "Numeric code (1-13) for the statistical cause of the fire; pairs with STAT_CAUSE_DESCR (1 = Lightning, 5 = Debris Bu